# ---- Core ----
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-string
JWT_SECRET_KEY=change-this-to-a-different-long-random-string
JWT_ACCESS_TOKEN_EXPIRES_MIN=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7
DATABASE_URL=sqlite:///brandgen.db
FRONTEND_ORIGIN=http://127.0.0.1:5500

# ---- AI Service (name generation) ----
# Required for real name generation. Without this, AIService runs in
# "unavailable" mode and the API returns a clear 503 explaining why.
AI_MODEL=gemini-3.5-flash
GEMINI_API_KEY=

# ---- Logo Generation (Imagen, via the SAME GEMINI_API_KEY above) ----
# Google's Gemini Developer API serves Imagen image models through the same
# key/client used for text generation — no second provider or key needed.
IMAGE_MODEL=imagen-4.0-generate-001

# ---- Trademark Screening Service ----
# provider options:
#   none         (default) — honest "Search Failed" state, no network call
#   markerapi    — USPTO/US-only wordmark search via markerapi.com's
#                  documented REST API. Requires an active markerapi
#                  subscription (username + password, not a bearer key).
#                  Only covers the US — screening requests for other
#                  jurisdictions (e.g. India) get an honest "not applicable"
#                  result pointing at the correct official registry instead.
#   generic_rest — bring-your-own REST provider. You must adapt
#                  TrademarkService._search_generic_rest() to your actual
#                  provider's response shape before relying on it.
TRADEMARK_PROVIDER=none
TRADEMARK_API_USERNAME=
TRADEMARK_API_PASSWORD=
TRADEMARK_API_KEY=
TRADEMARK_API_BASE_URL=

# ---- Domain Availability Service ----
# provider options:
#   rdap         (default) — free, public, no-key IANA/ICANN RDAP bootstrap
#                  (https://rdap.org). Real registry data, zero config.
#   none         — disable outbound domain lookups entirely
#   generic_rest — bring-your-own registrar/WHOIS API (Namecheap, GoDaddy,
#                  WhoisXML, etc). Adapt DomainService._check_generic_rest()
#                  to your actual provider's response shape first.
DOMAIN_PROVIDER=rdap
DOMAIN_API_KEY=
DOMAIN_API_BASE_URL=

# ---- Payment Service ----
# provider options:
#   none    (default) — checkout/portal return an honest 503, no webhook processed
#   stripe  — real, live: set PAYMENT_API_KEY to a Stripe secret key
#             (sk_test_... / sk_live_...) and PAYMENT_WEBHOOK_SECRET to the
#             signing secret for the webhook endpoint you register in the
#             Stripe dashboard pointing at POST /api/payments/webhook
#             (events: checkout.session.completed,
#             customer.subscription.updated, customer.subscription.deleted).
# Prices are NOT hard-coded; they live in the `plans` table (price_cents /
# currency / billing_period) and are sent to Stripe at checkout time.
PAYMENT_PROVIDER=none
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# ---- Rate limiting ----
RATELIMIT_STORAGE_URI=memory://
